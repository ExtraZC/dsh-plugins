{
  "name": "dsh-webchat-entry",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek web-chat entry for the DSH sidebar: a footer action that opens chat.deepseek.com in a NEW browser tab, leaving the harness page untouched.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "sidebar",
    "deepseek",
    "web-chat"
  ],
  "files": [
    "src/",
    "lib/",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node --experimental-vm-modules scripts/build.mjs",
    "check": "node --experimental-vm-modules scripts/build.mjs --check"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react",
        "react/jsx-runtime"
      ]
    }
  }
}
